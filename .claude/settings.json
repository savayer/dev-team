{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3"
  },
  "permissions": {
    "allow": [
      "Bash(git push -u origin team/*)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(docker push*)",
      "Bash(docker buildx * --push*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git -c *)",
      "Bash(yarn npm publish*)",
      "Bash(bun publish*)",
      "Bash(cargo publish*)",
      "Bash(docker image push*)",
      "Bash(docker compose push*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl delete*)",
      "Bash(kubectl create*)",
      "Bash(kubectl patch*)",
      "Bash(kubectl edit*)",
      "Bash(kubectl scale*)",
      "Bash(kubectl rollout*)",
      "Bash(kubectl exec*)",
      "Bash(helm install*)",
      "Bash(helm upgrade*)",
      "Bash(helm uninstall*)",
      "Bash(helm rollback*)",
      "Bash(helm push*)",
      "Bash(terraform *)",
      "Bash(tofu *)",
      "Bash(pulumi *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(**/*.pem)",
      "Read(**/secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-push.mjs\" || exit 2"
          }
        ]
      }
    ]
  }
}
