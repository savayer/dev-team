{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  },
  "permissions": {
    "deny": [
      "Bash(git push *)",
      "Bash(git -C * push*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(docker push*)",
      "Bash(docker buildx * --push*)",
      "Bash(gh workflow run*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git -c *)",
      "Bash(gh *)",
      "Bash(yarn npm publish*)",
      "Bash(bun publish*)",
      "Bash(cargo publish*)",
      "Bash(docker image push*)",
      "Bash(docker compose push*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl delete*)",
      "Bash(kubectl create*)",
      "Bash(kubectl patch*)",
      "Bash(kubectl edit*)",
      "Bash(kubectl scale*)",
      "Bash(kubectl rollout*)",
      "Bash(kubectl exec*)",
      "Bash(helm install*)",
      "Bash(helm upgrade*)",
      "Bash(helm uninstall*)",
      "Bash(helm rollback*)",
      "Bash(helm push*)",
      "Bash(terraform *)",
      "Bash(tofu *)",
      "Bash(pulumi *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(**/*.pem)",
      "Read(**/secrets/**)"
    ]
  }
}
